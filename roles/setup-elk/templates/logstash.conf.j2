input {
  beats {
    port => 5044
  }
}

filter {
  mutate {
    add_field => {
      "managed_by" => "ansible"
      "environment" => "production"
      "pipeline_version" => "v2"
    }
  }

  date {
    match => ["@timestamp", "ISO8601"]
    target => "@timestamp"
  }
}

output {
  elasticsearch {
    hosts => ["http://elasticsearch:9200"]
    user => "elastic"
    password => "${ELASTIC_PASSWORD}"
  }

  stdout {
    codec => rubydebug
  }
}
